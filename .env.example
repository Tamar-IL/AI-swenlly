# The Conductor runs with ZERO keys by default (offline Mock provider).
# Everything below is OPTIONAL — set a key only to enable a real free provider.

# --- Provider selection -------------------------------------------------
# Which provider backs the model catalog. Default: "mock" (deterministic, offline, no key).
# Options: mock | openrouter
CONDUCTOR_PROVIDER=mock

# --- OpenRouter (optional, has a FREE tier of open models) --------------
# Get a free key at https://openrouter.ai/keys — free models cost $0.
# Only used when CONDUCTOR_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# --- Cost guardrails ----------------------------------------------------
# Hard per-session spend cap in USD. When a session's cumulative estimated
# cost would exceed this, the Conductor gates further answers. Default: 0.05
CONDUCTOR_SESSION_CAP_USD=0.05
